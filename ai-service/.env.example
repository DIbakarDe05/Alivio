# 3 Distinct Google Cloud Projects / Accounts for 45 RPM Aggregate Capacity
GEMINI_API_KEY_VISION=your_project_a_vision_api_key_here
GEMINI_API_KEY_TRIAGE=your_project_b_triage_api_key_here
GEMINI_API_KEY_CHATBOT=your_project_c_chatbot_api_key_here

# Model & Runtime Settings
MODEL_NAME=gemini-2.5-flash
PORT=8000
LOG_LEVEL=INFO
PROMPT_VERSION=2.1.0

# Strict Memory, Size & Deadline Guardrails
INFERENCE_TIMEOUT_SECONDS=6.0
PER_ATTEMPT_TIMEOUT_SECONDS=3.2
MAX_ATTEMPTS=2
KEY_COOLDOWN_SECONDS=15.0
MAX_IMAGE_BYTES=5242880
MAX_REQUEST_BODY_BYTES=8388608
MAX_IN_FLIGHT_REQUESTS=30
CHAT_INPUT_TOKEN_BUDGET=1500

# Security & Network Allowlists (JSON arrays)
ALLOWED_ORIGINS=["http://localhost:5000","http://localhost:5173"]
IMAGE_URL_ALLOWED_HOSTS=["res.cloudinary.com"]
